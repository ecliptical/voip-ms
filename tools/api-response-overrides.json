  "methods": {
    "getJoinWhenEmptyTypes": {
      "patches": [
        { "path": "types[].value",       "type": "string", "sample": "yes" },
        { "path": "types[].description", "type": "string", "sample": "Yes" }
      ]
    },
    "getPlayInstructions": {
      "patches": [
        { "path": "play_instructions[].description", "type": "string", "sample": "Yes" }
      ]
    },
    "getDIDsInfo": {
      "additions": [
        { "path": "dids[].dialmode",                  "type": "integer" },
        { "path": "dids[].inbound_dialing_mode",      "type": "integer" },
        { "path": "dids[].mms_available",             "type": "bool_01" },
        { "path": "dids[].record_calls",              "type": "bool_01" },
        { "path": "dids[].sms_sipaccount",            "type": "string" },
        { "path": "dids[].sms_sipaccount_enabled",    "type": "bool_01" },
        { "path": "dids[].transcription_start_delay", "type": "integer" },
        { "path": "dids[].voicemail_threshold",       "type": "integer" },
        { "path": "dids[].webhook",                   "type": "string" },
        { "path": "dids[].webhook_enabled",           "type": "bool_01" }
      ],
      "patches": [
        { "path": "dids[].sms_available", "type": "bool_01", "sample": "1" },
        { "path": "dids[].sms_enabled",   "type": "bool_01", "sample": "1" }
      ]
    },
    "getDIDvPRI": {
      "patches": [
        { "path": "dids[]", "type": "string", "sample": "7862285619" }
      ]
    },
    "getReportEstimatedHoldTime": {
      "patches": [
        { "path": "types[].value",       "type": "string", "sample": "once" },
        { "path": "types[].description", "type": "string", "sample": "Yes, only once" }
      ]
    },
    "getCallerIDFiltering": {
      "patches": [
        { "path": "filtering[].callerid", "type": "string", "sample": "John Doe <5551234567>" }
      ]
    },
    "getPhonebook": {
      "patches": [
        { "path": "phonebooks[].callerid", "type": "string", "sample": "John Doe <5552223333>" }
      ]
    },
    "getVoicemailMessages": {
      "patches": [
        { "path": "messages[].date",     "type": "datetime", "sample": "2016-01-30 09:15:42" },
        { "path": "messages[].callerid", "type": "string",   "sample": "John Doe <5551234567>" }
      ]
    },
    "getTerminationRates": {
      "shape": {
        "kind": "object",
        "fields": [
          { "name": "status", "shape": { "kind": "scalar", "type": "string", "sample": "success" } },
          { "name": "route", "shape": { "kind": "list", "element": { "kind": "object", "fields": [
            { "name": "value",       "shape": { "kind": "scalar", "type": "integer", "sample": "2" } },
            { "name": "description", "shape": { "kind": "scalar", "type": "string",  "sample": "Premium" } }
          ] } } },
          { "name": "rates", "shape": { "kind": "list", "element": { "kind": "object", "fields": [
            { "name": "destination", "shape": { "kind": "scalar", "type": "string",  "sample": "Canada - 204 Manitoba" } },
            { "name": "prefix",      "shape": { "kind": "scalar", "type": "integer", "sample": "1204" } },
            { "name": "increment",   "shape": { "kind": "scalar", "type": "integer", "sample": "6" } },
            { "name": "rate",        "shape": { "kind": "scalar", "type": "decimal", "sample": "0.009" } }
          ] } } }
        ]
      }
    },
    "e911AddressTypes": {
      "shape": {
        "kind": "object",
        "fields": [
          { "name": "status", "shape": { "kind": "scalar", "type": "string", "sample": "success" } },
          { "name": "types", "shape": { "kind": "list", "element": { "kind": "object", "fields": [
            { "name": "value",       "shape": { "kind": "scalar", "type": "string", "sample": "Apartment" } },
            { "name": "description", "shape": { "kind": "scalar", "type": "string", "sample": "Apartment" } }
          ] } } }
        ]
      }
    },
    "getLNPListStatus": {
      "shape": {
