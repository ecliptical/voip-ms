  "param_docs": {
    "addLNPPort.btn": "Required if `is_mobile` is true. BTN (billing telephone number): the phone number all of the customer's other numbers are charged to on one consolidated bill. Look for it on your invoice, or ask the current provider for it.",
    "addLNPPort.isMobile": "true if all the numbers are mobile numbers. Default: false",
    "addLNPPort.isPartial": "true if you have more than one number with your current carrier and are not porting them all, false if you are porting all of them. Either way, list every number you want to port in `numbers`. Default: false",
    "addLNPPort.locationType": "Whether the numbers are a business's or a residence's. Default: residential",
    "addLNPPort.services": "Required if `is_mobile` is true. Describe every service you keep with the current carrier, such as DSL/data or hunt group services. A service not listed may be disconnected when the port completes.",
    "createSubAccount.allow225": "true if a call placed to *225 hears the account's current balance, false if it is rejected",
    "createSubAccount.reseller_nextbilling": "Required if `reseller_package` is set, even for a package with no monthly or setup fee. Reseller Next Billing Date, which must not be in the past (Example: '2012-12-31')",
    "delLocation.id": "Internal Extension Location id (Values from getLocations) (required)",
    "setCallHunting.press": "Whether the member must press 1 to take the call, one item per member in `members` (required)",
    "setCallHunting.recording": "Recording for the Call Hunting: a recording id from getRecordings, or `default` for the system recording (required)",
    "setCallHunting.ring_time": "The maximum time the call rings the member, one item per member in `members` (required)",
    "setDIDInfo.inbound_dialing_mode": "How the DID presents the caller of an inbound call (Values: 0 = NANPA, 10 digits; 1 = E.164, with the country code)",
    "setDIDInfo.transcription_redaction": "true to redact sensitive information from call transcriptions. Stored only while `transcribe` is true",
    "setDIDInfo.transcription_sentiment": "true to add a sentiment analysis to call transcriptions. Stored only while `transcribe` is true",
    "setDIDInfo.transcription_summary": "true to add a summary to call transcriptions. Stored only while `transcribe` is true",
    "setSMS.dialmode": "How messages sent through the API from this DID are addressed (Values: 0 = no mode chosen, what a DID reports until one is set; 1 = NANPA, 10 digits without the +1 prefix; 2 = E.164, the country code first with the +1 prefix)",
    "setSMS.webhook": "Webhook URL: SMS and MMS messages the DID receives are sent as a POST request to it (for a 3CX or PortSIP PBX)",
    "setSMS.webhook_enable": "true to send the SMS and MMS messages the DID receives to `webhook`",
    "setQueue.fail_over_routing_join_unavail": "Same as `failover_routing_join_empty`, except that there were still queue members, but all were status unavailable",
    "setQueue.fail_over_routing_leave_unavail": "Same as `failover_routing_leave_empty`, except that there were still queue members, but all were status unavailable",
    "setRecording.recording": "ID for a specific Recording (Example: 33221 / Leave empty to create a new one)",
    "setRingGroup.members": "Members for the Ring Group, separated by `;`. Each is a routing `header:record_id` whose header is `account` (an account or sub-account), `fwd` (a forwarding) or `sip` (a SIP URI), optionally followed by its ring time in seconds (1 to 60, default 25) and whether it must press 1 to take the call (1 or 0, default 0), separated by commas (Example: 'account:100001,25,0;fwd:16006,10,1') (required)",
    "setSubAccount.default_e911": "The caller ID sent on emergency (911) calls from this sub-account",
    "setSubAccount.allow225": "true if a call placed to *225 hears the account's current balance, false if it is rejected",
    "setSubAccount.ip_restriction": "List of IP Addresses, IP Addresses/Netmask, or Fully Qualified Domain Names to allow outgoing calls separated by commas (Example: 123.45.3.21,10.255.12.0/22,device.mydomain.com)",
    "setSubAccount.reseller_nextbilling": "Required if `reseller_package` is set, even for a package with no monthly or setup fee. Reseller Next Billing Date, which must not be in the past (Example: '2012-12-31')",
    "getLNPList.portid": "ID of one port request to list. Omit to list all",
    "addLNPPort.portType": "Kind of numbers to port (Values: 1 = United States local numbers, 2 = Canadian local numbers, 3 = US/CA toll-free numbers, 4 = United States fax numbers, 5 = Canadian fax numbers) (required)",
    "addLNPPort.tfType": "Required if `port_type` is 3. Which carrier the toll-free numbers are with (Values: 1 = an American carrier, American callers only; 2 = an American carrier, American and Canadian callers; 3 = a Canadian carrier)",
    "assignDIDvPRI.did": "DID to assign to the vPRI (Example: 5551234567) (required)",
    "removeDIDvPRI.did": "DID to remove from the vPRI (Example: 5551234567) (required)",
    "connectDID.did": "DID to connect to the reseller sub-account (Example: 5551234567) (required)",
    "connectDID.monthly": "Monthly fee for the reseller client (Example: 3.50) (required)",
    "connectFAX.monthly": "Monthly fee for the reseller client (Example: 3.50) (required)",
    "orderDID.monthly": "Monthly fee for the reseller client (Example: 3.50)",
    "orderDIDInternationalGeographic.monthly": "Monthly fee for the reseller client (Example: 3.50)",
    "orderDIDInternationalNational.monthly": "Monthly fee for the reseller client (Example: 3.50)",
    "orderDIDInternationalTollFree.monthly": "Monthly fee for the reseller client (Example: 3.50)",
    "orderDIDVirtual.monthly": "Monthly fee for the reseller client (Example: 3.50)",
    "orderTollFree.monthly": "Monthly fee for the reseller client (Example: 3.50)",
    "orderVanity.monthly": "Monthly fee for the reseller client (Example: 3.50)",
    "mailFaxMessagePDF.email": "Destination email address (Example: yourname@company.com) (required)",
    "setTimeCondition.routing_nomatch": "Routing for the call when the condition does not match (required)",
    "setFaxNumberInfo.did": "Fax number to update (Example: 5552341234) (required)",
    "setFaxNumberInfo.email_attach_file": "true to attach the fax message to the email notification as a PDF file; getFaxNumbersInfo reports it as `attach_file`. Default: false",
    "setFaxNumberInfo.url_callback": "URL a POST request is sent to when a fax message arrives; getFaxNumbersInfo reports it as `url`",
    "setFaxNumberInfo.url_callback_enable": "true to send the POST request to `url_callback`; getFaxNumbersInfo reports it as `url_enabled`. Default: false",
    "setFaxNumberInfo.url_callback_retry": "true to repeat the POST request until the page answers `ok`; getFaxNumbersInfo reports it as `retry`",
    "setFaxNumberInfo.max_attempts": "The fax number's maximum number of attempts, which getFaxNumbersInfo reports as `max_attempts` (Example: 5). A call without it sets it to 10, and 0 leaves it as it is",
    "setFaxNumberEmail.did": "Fax number to update (Example: 5552341234) (required)",
    "setFaxNumberEmail.email_attach_file": "true to attach the fax message to the email notification as a PDF file; getFaxNumbersInfo reports it as `attach_file`. Default: false",
    "setFaxNumberURLCallback.did": "Fax number to update (Example: 5552341234) (required)",
    "setFaxNumberURLCallback.url_callback": "URL a POST request is sent to when a fax message arrives; getFaxNumbersInfo reports it as `url`",
    "setFaxNumberURLCallback.url_callback_enable": "true to send the POST request to `url_callback`; getFaxNumbersInfo reports it as `url_enabled`. Default: false",
    "setFaxNumberURLCallback.url_callback_retry": "true to repeat the POST request until the page answers `ok`; getFaxNumbersInfo reports it as `retry`",
    "setSMS.enable": "true to let the DID receive SMS messages; getDIDsInfo reports it as `sms_enabled` (required)",
    "setSMS.email_address": "Email address the SMS messages the DID receives are sent to; getDIDsInfo reports it as `sms_email`",
    "setSMS.email_enabled": "true to send the SMS messages the DID receives to `email_address`; getDIDsInfo reports it as `sms_email_enabled`",
    "setSMS.url_callback": "URL the SMS messages the DID receives are sent to as a GET request, with {FROM} replaced by the number that sent the message, {TO} by the DID that received it and {MESSAGE} by its content (Example: http://mysite.com/sms.php?to={TO}&from={FROM}&message={MESSAGE}); getDIDsInfo reports it as `sms_url_callback`",
    "setSMS.url_callback_enable": "true to send the SMS messages the DID receives to `url_callback`; getDIDsInfo reports it as `sms_url_callback_enabled`",
    "setSMS.url_callback_retry": "true to resend a message to `url_callback` every 30 minutes until the page answers `ok`; getDIDsInfo reports it as `sms_url_callback_retry`"
  },
